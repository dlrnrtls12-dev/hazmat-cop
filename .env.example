# 공공데이터포털 일반 인증키 (소방청, 안전보건공단, 국토교통부 등)
DATA_GO_KR_API_KEY=your_data_go_kr_api_key_here

# 법제처 국가법령정보 API ID
LAW_API_ID=your_law_api_id_here

# 국토교통부 브이월드(V-World) API KEY
VWORLD_API_KEY=your_vworld_api_key_here

# 소방청 국가위험물정보조회서비스 엔드포인트
NFA_HAZMAT_API_URL=https://apis.data.go.kr/1661000/HazmatInfoService

# 안전보건공단 MSDS 조회서비스 엔드포인트
KOSHA_MSDS_API_URL=https://apis.data.go.kr/B490001/koshaMsdsService

# 국토교통부 건축물대장 및 인허가 HUB
ARCH_BLD_HUB_URL=https://apis.data.go.kr/1613000/BldRgstHubService
ARCH_PMS_HUB_URL=https://apis.data.go.kr/1613000/ArchPmsService

# 경기도 데이터드림 엔드포인트
GG_HAZMAT_FACILITY_URL=https://openapi.gg.go.kr/HazmatFacility
GG_CHEM_BIZ_URL=https://openapi.gg.go.kr/ToxicChemicalsBiz

# LLM API 키 (선택사항)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
